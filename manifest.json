{
	"manifest_version": 3,
	"name": "eBay Copy Assistant",
	"version": "1.1.1",
	"description": "One-click copy of eBay product details as a prompt-ready text for chatbot consultation.",
	"permissions": ["storage", "alarms"],
	"host_permissions": [
		"https://*.ebaydesc.com/*",
		"https://*.ebay.com/*",
		"https://i.ebayimg.com/*",
		"https://gemini.google.com/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": [
				"https://*.ebay.com/itm/*",
				"https://*.ebay.co.uk/itm/*",
				"https://*.ebay.de/itm/*",
				"https://*.ebay.fr/itm/*",
				"https://*.ebay.it/itm/*",
				"https://*.ebay.es/itm/*",
				"https://*.ebay.com.au/itm/*",
				"https://*.ebay.ca/itm/*",
				"https://*.ebay.at/itm/*",
				"https://*.ebay.pl/itm/*"
			],
			"js": [
				"config.js",
				"gallery-extractor.js",
				"extractors.js",
				"photo-picker.js",
				"ui.js",
				"content.js"
			],
			"css": ["content.css"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://gemini.google.com/*"],
			"js": [
				"config.js",
				"photo-transfer.js",
				"gemini-editor.js",
				"gemini-attachments.js",
				"gemini-content.js"
			],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
