{
	"manifest_version": 3,
	"name": "eBay Copy Assistant",
	"version": "1.1.2",
	"description": "One-click copy of eBay product details as a prompt-ready text for chatbot consultation.",
	"permissions": ["storage", "alarms"],
	"host_permissions": [
		"https://*.ebaydesc.com/*",
		"https://*.ebay.com/*",
		"https://i.ebayimg.com/*",
		"https://gemini.google.com/*"
	],
	"background": {
		"service_worker": "src/entrypoints/background.js"
	},
	"options_page": "src/options/options.html",
	"content_scripts": [
		{
			"matches": [
				"https://*.ebay.com/itm/*",
				"https://*.ebay.co.uk/itm/*",
				"https://*.ebay.de/itm/*",
				"https://*.ebay.fr/itm/*",
				"https://*.ebay.it/itm/*",
				"https://*.ebay.es/itm/*",
				"https://*.ebay.com.au/itm/*",
				"https://*.ebay.ca/itm/*",
				"https://*.ebay.at/itm/*",
				"https://*.ebay.pl/itm/*"
			],
			"js": [
				"src/domain/policy.js",
				"src/domain/prompt.js",
				"src/ebay/config.js",
				"src/infrastructure/chrome-client.js",
				"src/ebay/gallery.js",
				"src/ebay/reader.js",
				"src/ebay/photo-picker.js",
				"src/ebay/view.js",
				"src/application/start-ebay.js",
				"src/entrypoints/ebay.js"
			],
			"css": ["src/ebay/content.css"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://gemini.google.com/*"],
			"js": [
				"src/domain/policy.js",
				"src/domain/photo-codec.js",
				"src/infrastructure/chrome-client.js",
				"src/gemini/editor.js",
				"src/gemini/attachments.js",
				"src/gemini/status.js",
				"src/gemini/chat-observer.js",
				"src/gemini/files.js",
				"src/application/gemini.js",
				"src/entrypoints/gemini.js"
			],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
